+/* A fault while a KeUserModeCallback is on the stack. Stack buffer, at most 64 lines
+ * per process, no heap. Single-step and breakpoints are not this record. */
+static void ps5_log_callback_fault( EXCEPTION_RECORD *rec, CONTEXT *context )
+{
+    static int lines;
+    struct amd64_thread_data *cpu = amd64_thread_data();
+    char line[512], where[80], caller[80];
+    ULONG_PTR slots[16], rsp, limit, base, rbp, ret, next;
+    unsigned int id, n, i;
+    const char *access = "-";
+    ULONG_PTR target = 0;
+    ULONG64 caller_rip = 0;
+
+    if (!cpu->ps5_callback_depth) return;
+    if (rec->ExceptionCode == EXCEPTION_SINGLE_STEP || rec->ExceptionCode == EXCEPTION_BREAKPOINT) return;
+    if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 64) return;
+
+    if (rec->NumberParameters >= 1)
+    {
+        if (rec->ExceptionInformation[0] == 0) access = "read";
+        else if (rec->ExceptionInformation[0] == 1) access = "write";
+        else if (rec->ExceptionInformation[0] == 8) access = "execute";
+        else access = "other";
+    }
+    if (rec->NumberParameters >= 2) target = rec->ExceptionInformation[1];
+    id = cpu->ps5_callback_id;
+    ps5_module_of( (ULONG_PTR)rec->ExceptionAddress, where, sizeof(where) );
+    caller[0] = '-';
+    caller[1] = 0;
+    if (cpu->ps5_callback_stack &&
+        ps5_read_bytes( (char *)cpu->ps5_callback_stack + 0x30, &caller_rip, sizeof(caller_rip) ) &&
+        caller_rip)
+        ps5_module_of( (ULONG_PTR)caller_rip, caller, sizeof(caller) );
+    snprintf( line, sizeof(line),
+              "wine-ps5: callback-fault where=unix code=%#x flags=%#x addr=%p params=%u access=%s target=%#llx "
+              "rip=%s id=%u name=%s depth=%u stack=%p from=%s to=%s caller=%s\n",
+              (unsigned int)rec->ExceptionCode, (unsigned int)rec->ExceptionFlags, rec->ExceptionAddress,
+              (unsigned int)rec->NumberParameters, access, (unsigned long long)target, where, id,
+              ps5_callback_name( id ), cpu->ps5_callback_depth, cpu->ps5_callback_stack,
+              id < 25 ? "win32u" : "?", id < 25 ? "user32" : "?", caller );
+    ps5_log_line( line );
+    if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 64) return;
+    snprintf( line, sizeof(line),
+              "wine-ps5: callback-fault regs rax=%#llx rbx=%#llx rcx=%#llx rdx=%#llx rsi=%#llx rdi=%#llx "
+              "rbp=%#llx rsp=%#llx r8=%#llx r9=%#llx r10=%#llx r11=%#llx r12=%#llx r13=%#llx r14=%#llx r15=%#llx\n",
+              (unsigned long long)context->Rax, (unsigned long long)context->Rbx,
+              (unsigned long long)context->Rcx, (unsigned long long)context->Rdx,
+              (unsigned long long)context->Rsi, (unsigned long long)context->Rdi,
+              (unsigned long long)context->Rbp, (unsigned long long)context->Rsp,
+              (unsigned long long)context->R8, (unsigned long long)context->R9,
+              (unsigned long long)context->R10, (unsigned long long)context->R11,
+              (unsigned long long)context->R12, (unsigned long long)context->R13,
+              (unsigned long long)context->R14, (unsigned long long)context->R15 );
+    ps5_log_line( line );
+
+    rsp = context->Rsp;
+    limit = (ULONG_PTR)NtCurrentTeb()->Tib.StackLimit;
+    base = (ULONG_PTR)NtCurrentTeb()->Tib.StackBase;
+    n = 0;
+    if (!(rsp & 7) && rsp >= limit && rsp < base)
+    {
+        n = (unsigned int)((base - rsp) / sizeof(ULONG_PTR));
+        if (n > 16) n = 16;
+        if (!ps5_read_bytes( (void *)rsp, slots, n * sizeof(ULONG_PTR) )) n = 0;
+    }
+    for (i = 0; i < n; i++)
+    {
+        if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 64) return;
+        ps5_module_of( slots[i], where, sizeof(where) );
+        snprintf( line, sizeof(line), "wine-ps5: callback-fault stack%u %#llx %s\n",
+                  i, (unsigned long long)slots[i], where );
+        ps5_log_line( line );
+    }
+    rbp = context->Rbp;
+    for (i = 0; i < 16; i++)
+    {
+        if ((rbp & 7) || rbp < limit || rbp + 16 > base) break;
+        if (!ps5_read_bytes( (void *)rbp, &next, sizeof(next) )) break;
+        if (!ps5_read_bytes( (void *)(rbp + 8), &ret, sizeof(ret) )) break;
+        if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 64) return;
+        ps5_module_of( ret, where, sizeof(where) );
+        snprintf( line, sizeof(line), "wine-ps5: callback-fault frame%u rip=%#llx %s rbp=%#llx\n",
+                  i, (unsigned long long)ret, where, (unsigned long long)rbp );
+        ps5_log_line( line );
+        if (next <= rbp) break;
+        rbp = next;
+    }
+}
