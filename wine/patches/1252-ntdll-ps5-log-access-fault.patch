From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Subject: [PATCH] ntdll: PS5: log an access fault and an image protect or write

5653f96 was installed. Both WowB Crash.txt lines are a write of
WowB_loader+0x2017E3B at ntdll+0x538C0, the hotpatch NOP at
RtlEqualPrefixSid. That function does not store. This patch only logs.

An access violation about to be delivered writes one line, at most 32 a
process: wine-ps5: access-fault with the signal frame's trap and error
code, its RIP, the context RIP, the exception address Crash.txt prints,
the access kind, 16 bytes at the signal RIP, the view and page byte of
both addresses, and up to six return addresses as module+RVA. The record
and the frame are not changed.

NtProtectVirtualMemory and NtWriteVirtualMemory write one line when the
range overlaps ntdll.dll or WowB_loader.dll, at most 64 a process:
wine-ps5: image-protect or image-write, with the module and RVA, the
address, the size, the new and old protection or the bytes written, and
the status. The call returns what it returned before.

Syscall numbers are unchanged. The compare of protocol 0x3a3 is the same
instruction. No console run.
---
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 4e3f400..5c69c9f 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2073,6 +2073,90 @@ static BOOL ps5_try_umip( ucontext_t *ctx, siginfo_t *info, int signal )
     leave_handler( ctx );
     return TRUE;
 }
+
+/* View base, allocation flags and page byte. Fills out. Does not change the mapping. */
+extern void ps5_describe_address( const void *addr, char *out, size_t n );
+
+/* One line, at most 32 a process, for an access violation about to be delivered.
+ * pc is the signal frame's RIP. exc is the exception record, which Crash.txt prints.
+ * bytes are 16 bytes at pc. Nothing here changes the record or the frame. */
+static void ps5_log_access( ucontext_t *ctx, EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    static int lines;
+    BYTE bytes[16];
+    char hex[40], pcmod[80], faultmod[80], pcview[160], faultview[160], bt[400], line[1600];
+    ULONG_PTR pc, exc, fault, rsp, rbp, limit, base, slot, ret, next;
+    unsigned int i, n, pos, nbt;
+    int wrote;
+    const char *access = "other";
+
+    if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 32) return;
+
+    pc = (ULONG_PTR)RIP_sig(ctx);
+    exc = (ULONG_PTR)rec->ExceptionAddress;
+    fault = rec->NumberParameters >= 2 ? rec->ExceptionInformation[1] : 0;
+    if (rec->NumberParameters >= 1)
+    {
+        if (rec->ExceptionInformation[0] == EXCEPTION_READ_FAULT) access = "read";
+        else if (rec->ExceptionInformation[0] == EXCEPTION_WRITE_FAULT) access = "write";
+        else if (rec->ExceptionInformation[0] == EXCEPTION_EXECUTE_FAULT) access = "execute";
+    }
+    n = (unsigned int)virtual_uninterrupted_read_memory( (void *)pc, bytes, sizeof(bytes) );
+    pos = 0;
+    hex[0] = 0;
+    for (i = 0; i < n && i < sizeof(bytes); i++)
+    {
+        wrote = snprintf( hex + pos, sizeof(hex) - pos, "%02x", bytes[i] );
+        if (wrote < 0 || (unsigned int)wrote >= sizeof(hex) - pos) break;
+        pos += wrote;
+    }
+    ps5_module_of( pc, pcmod, sizeof(pcmod) );
+    ps5_module_of( fault, faultmod, sizeof(faultmod) );
+    ps5_describe_address( (void *)pc, pcview, sizeof(pcview) );
+    ps5_describe_address( (void *)fault, faultview, sizeof(faultview) );
+
+    bt[0] = 0;
+    pos = 0;
+    nbt = 0;
+    rsp = (ULONG_PTR)RSP_sig(ctx);
+    rbp = (ULONG_PTR)RBP_sig(ctx);
+    limit = (ULONG_PTR)NtCurrentTeb()->Tib.StackLimit;
+    base = (ULONG_PTR)NtCurrentTeb()->Tib.StackBase;
+    if (!(rsp & 7) && rsp >= limit && rsp + sizeof(slot) <= base &&
+        ps5_read_bytes( (void *)rsp, &slot, sizeof(slot) ))
+    {
+        ps5_module_of( slot, pcmod, sizeof(pcmod) );
+        wrote = snprintf( bt + pos, sizeof(bt) - pos, "%s", pcmod );
+        if (wrote > 0 && (unsigned int)wrote < sizeof(bt) - pos) { pos += wrote; nbt++; }
+    }
+    for (i = 0; i < 6 && nbt < 6; i++)
+    {
+        char where[80];
+
+        if ((rbp & 7) || rbp < limit || rbp + 16 > base) break;
+        if (!ps5_read_bytes( (void *)rbp, &next, sizeof(next) )) break;
+        if (!ps5_read_bytes( (void *)(rbp + 8), &ret, sizeof(ret) )) break;
+        ps5_module_of( ret, where, sizeof(where) );
+        wrote = snprintf( bt + pos, sizeof(bt) - pos, "%s%s", pos ? "," : "", where );
+        if (wrote < 0 || (unsigned int)wrote >= sizeof(bt) - pos) break;
+        pos += wrote;
+        nbt++;
+        if (next <= rbp) break;
+        rbp = next;
+    }
+    /* pcmod was reused for the first stack slot. Name the signal PC again. */
+    ps5_module_of( pc, pcmod, sizeof(pcmod) );
+    snprintf( line, sizeof(line),
+              "wine-ps5: access-fault trap=%#llx err=%#llx pc=%p %s ctx=%p exc=%p access=%s info0=%#llx "
+              "fault=%p %s bytes=%s pcview=%s faultview=%s bt=%s sigrsp=%p ctxrsp=%p rcx=%#llx rdx=%#llx\n",
+              (unsigned long long)TRAP_sig(ctx), (unsigned long long)ERROR_sig(ctx),
+              (void *)pc, pcmod, (void *)xcontext->c.Rip, (void *)exc, access,
+              rec->NumberParameters >= 1 ? (unsigned long long)rec->ExceptionInformation[0] : 0,
+              (void *)fault, faultmod, hex, pcview, faultview, bt[0] ? bt : "-",
+              (void *)RSP_sig(ctx), (void *)xcontext->c.Rsp,
+              (unsigned long long)RCX_sig(ctx), (unsigned long long)RDX_sig(ctx) );
+    ps5_log_line( line );
+}
 #endif
 
 
@@ -2094,6 +2178,8 @@ static void setup_raise_exception( ucontext_t *sigcontext, EXCEPTION_RECORD *rec
      * complete, so the page closes now, and the context the program gets keeps only its own trap flag. */
     if (virtual_ps5_step_done() && !ntdll_get_thread_data()->ps5_step_tf) context->EFlags &= ~0x100;
     ps5_log_callback_fault( rec, context );
+    if (rec->ExceptionCode == EXCEPTION_ACCESS_VIOLATION)
+        ps5_log_access( sigcontext, rec, xcontext );
 #endif
     if (rec->ExceptionCode == EXCEPTION_SINGLE_STEP)
     {
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index d48312b..2008b0a 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -7443,6 +7443,152 @@ NTSTATUS WINAPI NtFreeVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T *si
 }
 
 
+#ifdef __PROSPERO__
+/* Diagnostic only. A name from the PEB loader list, compared as ASCII without case. */
+static int ps5_ascii_name( const WCHAR *name, unsigned int chars, const char *ascii )
+{
+    unsigned int i;
+
+    for (i = 0; ascii[i]; i++)
+    {
+        WCHAR got, want;
+
+        if (i >= chars) return 0;
+        got = name[i];
+        want = (unsigned char)ascii[i];
+        if (got >= 'A' && got <= 'Z') got = got - 'A' + 'a';
+        if (want >= 'A' && want <= 'Z') want = want - 'A' + 'a';
+        if (got != want) return 0;
+    }
+    return i == chars;
+}
+
+/* 1 when [addr, addr+size) overlaps ntdll.dll or WowB_loader.dll. out receives name+RVA. */
+static int ps5_image_which( const void *addr, SIZE_T size, char *out, size_t n )
+{
+    PEB_LDR_DATA *ldr;
+    LIST_ENTRY link;
+    void *head;
+    ULONG_PTR start, end;
+    int i;
+    char overlap[96];
+
+    overlap[0] = 0;
+    if (!addr || !NtCurrentTeb()->Peb || !NtCurrentTeb()->Peb->LdrData || !n) return 0;
+    start = (ULONG_PTR)addr;
+    end = size ? start + size : start + 1;
+    if (end < start) end = ~(ULONG_PTR)0;
+    ldr = NtCurrentTeb()->Peb->LdrData;
+    head = &ldr->InMemoryOrderModuleList;
+    if (virtual_uninterrupted_read_memory( head, &link, sizeof(link) ) != sizeof(link)) return 0;
+    for (i = 0; i < 512 && link.Flink && link.Flink != head; i++)
+    {
+        struct
+        {
+            void *DllBase;
+            void *EntryPoint;
+            ULONG SizeOfImage;
+            ULONG pad;
+            UNICODE_STRING FullDllName;
+            UNICODE_STRING BaseDllName;
+        } info;
+        WCHAR wname[32];
+        void *entry = (char *)link.Flink - 0x10;
+        unsigned int chars;
+        ULONG_PTR base, image_end;
+        int named;
+
+        if (virtual_uninterrupted_read_memory( (char *)entry + 0x30, &info, sizeof(info) ) != sizeof(info))
+            break;
+        base = (ULONG_PTR)info.DllBase;
+        image_end = base + info.SizeOfImage;
+        chars = info.BaseDllName.Length / sizeof(WCHAR);
+        if (chars > 31) chars = 31;
+        named = info.SizeOfImage && chars &&
+                virtual_uninterrupted_read_memory( info.BaseDllName.Buffer, wname, chars * sizeof(WCHAR) ) ==
+                chars * sizeof(WCHAR) &&
+                (ps5_ascii_name( wname, chars, "ntdll.dll" ) ||
+                 ps5_ascii_name( wname, chars, "WowB_loader.dll" ));
+        if (named && start < image_end && end > base)
+        {
+            const char *module = ps5_ascii_name( wname, chars, "ntdll.dll" ) ? "ntdll.dll" : "WowB_loader.dll";
+
+            if (start >= base && start < image_end)
+            {
+                snprintf( out, n, "%s+%#llx", module, (unsigned long long)(start - base) );
+                return 1;
+            }
+            snprintf( overlap, sizeof(overlap), "%s+overlap", module );
+        }
+        if (virtual_uninterrupted_read_memory( link.Flink, &link, sizeof(link) ) != sizeof(link)) break;
+    }
+    if (!overlap[0]) return 0;
+    snprintf( out, n, "%s", overlap );
+    return 1;
+}
+
+/* At most 64 lines a process. The call's result is unchanged. */
+static void ps5_log_image_line( const char *line )
+{
+    static int lines;
+
+    if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 64) return;
+    fputs( line, stderr );
+}
+
+static void ps5_log_image_protect( const void *addr, SIZE_T size, ULONG neu, ULONG old,
+                                   unsigned int status, const void *from )
+{
+    char which[96], line[320];
+
+    if (!ps5_image_which( addr, size, which, sizeof(which) )) return;
+    snprintf( line, sizeof(line),
+              "wine-ps5: image-protect which=%s addr=%p size=%#zx new=%#x old=%#x status=%#x from=%p\n",
+              which, addr, size, neu, old, status, from );
+    ps5_log_image_line( line );
+}
+
+static void ps5_log_image_write( const void *addr, SIZE_T size, unsigned int status, SIZE_T written,
+                                 const void *from )
+{
+    char which[96], line[320];
+
+    if (!ps5_image_which( addr, size, which, sizeof(which) )) return;
+    snprintf( line, sizeof(line),
+              "wine-ps5: image-write which=%s addr=%p size=%#zx status=%#x written=%#zx from=%p\n",
+              which, addr, size, status, written, from );
+    ps5_log_image_line( line );
+}
+
+/* The view and page byte at addr. Stack buffer, no mapping change. */
+void ps5_describe_address( const void *addr, char *out, size_t n )
+{
+    struct file_view *view;
+    BYTE vprot, host;
+    const char *kind = "none";
+
+    if (!out || !n) return;
+    out[0] = 0;
+    mutex_lock( &virtual_mutex );
+    view = find_view( addr, 0 );
+    vprot = get_page_vprot( addr );
+    host = get_host_page_vprot( addr );
+    if (view)
+    {
+        if (view->protect & SEC_IMAGE) kind = "image";
+        else if (view->protect & SEC_FILE) kind = "file";
+        else if (is_view_valloc( view )) kind = "valloc";
+        else kind = "map";
+        snprintf( out, n, "base=%p size=%#zx alloc=%#x %s vprot=%#x hostv=%#x unix=%#x",
+                  view->base, view->size, view->protect, kind, vprot, host, get_unix_prot( vprot ) );
+    }
+    else
+        snprintf( out, n, "noview vprot=%#x hostv=%#x unix=%#x", vprot, host, get_unix_prot( vprot ) );
+    mutex_unlock( &virtual_mutex );
+}
+#endif
+
+
 /***********************************************************************
  *             NtProtectVirtualMemory   (NTDLL.@)
  *             ZwProtectVirtualMemory   (NTDLL.@)
@@ -7458,11 +7604,20 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
     SIZE_T size = *size_ptr;
     LPVOID addr = *addr_ptr;
     DWORD old;
+#ifdef __PROSPERO__
+    const void *from = __builtin_return_address( 0 );
+    SIZE_T asked = size;
+#endif
 
     TRACE("%p %p %08lx %08x\n", process, addr, size, new_prot );
 
     if (!old_prot)
+    {
+#ifdef __PROSPERO__
+        ps5_log_image_protect( addr, size, new_prot, 0, STATUS_ACCESS_VIOLATION, from );
+#endif
         return STATUS_ACCESS_VIOLATION;
+    }
 
     if (process != NtCurrentProcess())
     {
@@ -7476,7 +7631,13 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
         call.virtual_protect.size = size;
         call.virtual_protect.prot = new_prot;
         status = server_queue_process_apc( process, &call, &result );
-        if (status != STATUS_SUCCESS) return status;
+        if (status != STATUS_SUCCESS)
+        {
+#ifdef __PROSPERO__
+            ps5_log_image_protect( addr, size, new_prot, 0, status, from );
+#endif
+            return status;
+        }
 
         if (result.virtual_protect.status == STATUS_SUCCESS)
         {
@@ -7485,6 +7646,9 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
             *old_prot = result.virtual_protect.prot;
         }
         else *old_prot = PAGE_NOACCESS;
+#ifdef __PROSPERO__
+        ps5_log_image_protect( addr, size, new_prot, *old_prot, result.virtual_protect.status, from );
+#endif
         return result.virtual_protect.status;
     }
 
@@ -7545,6 +7709,9 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
         *old_prot = old;
     }
     else *old_prot = PAGE_NOACCESS;
+#ifdef __PROSPERO__
+    ps5_log_image_protect( addr, asked, new_prot, *old_prot, status, from );
+#endif
     return status;
 }
 
@@ -8911,6 +9078,10 @@ NTSTATUS WINAPI NtWriteVirtualMemory( HANDLE process, void *addr, const void *bu
                                       SIZE_T size, SIZE_T *bytes_written )
 {
     unsigned int status;
+    SIZE_T asked = size;
+#ifdef __PROSPERO__
+    const void *from = __builtin_return_address( 0 );
+#endif
 
     if (virtual_check_buffer_for_read( buffer, size ))
     {
@@ -8930,6 +9101,9 @@ NTSTATUS WINAPI NtWriteVirtualMemory( HANDLE process, void *addr, const void *bu
         size = 0;
     }
     if (bytes_written) *bytes_written = size;
+#ifdef __PROSPERO__
+    ps5_log_image_write( addr, asked, status, size, from );
+#endif
     return status;
 }
 
