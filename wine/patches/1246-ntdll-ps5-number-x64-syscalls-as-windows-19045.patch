From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Subject: [PATCH] ntdll: PS5: number x64 syscalls as Windows 10 build 19045

This Wine reports 10.0.19045. On x64 that build, 0xe9 is
NtFlushInstructionCache and NtSetIoCompletion is 0x1a3. The generated
table was dense, so 0xe9 was NtSetIoCompletion. make_specfiles copied one
spec number into both lists. The 32-bit list stays that dense assignment.
The 64-bit list is the 19045 table. NtAlertMultipleThreadByThreadId, the
one Wine-only ntdll service, is 0x1d9, still below the win32u bit.

The service table, the argument counts and the name array are [id] = value.
A Windows service this Wine does not implement is NULL. The x64 dispatcher
tests the slot and returns STATUS_INVALID_SYSTEM_SERVICE (0xC000001C).
trace_syscall and ps5_syscall_name index the name array and reject an id
past its length. ps5_narrow_syscall_args stays designated by the same id.

No console run.
---
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index d70dc84..1f0c0ee 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -141,16 +141,20 @@ static void stub_syscall( const char *name )
 #define SYSCALL_STUB(name) static void name(void) { stub_syscall( #name ); }
 ALL_SYSCALL_STUBS
 
+/* [id] = function. On the 64-bit build the id is the Windows 10 build 19045 x64
+ * number, so a hole (a service this Wine does not implement) is NULL. The
+ * dispatcher returns STATUS_INVALID_SYSTEM_SERVICE for that slot. The 32-bit
+ * list is still dense, and the same initializer is that dense table. */
 static void * const syscalls[] =
 {
-#define SYSCALL_ENTRY(id,name,args) name,
+#define SYSCALL_ENTRY(id,name,args) [id] = name,
     ALL_SYSCALLS
 #undef SYSCALL_ENTRY
 };
 
 static BYTE syscall_args[ARRAY_SIZE(syscalls)] =
 {
-#define SYSCALL_ENTRY(id,name,args) args,
+#define SYSCALL_ENTRY(id,name,args) [id] = args,
     ALL_SYSCALLS
 #undef SYSCALL_ENTRY
 };
@@ -180,7 +184,7 @@ enum
 
 static const char *ntsyscall_names[] =
 {
-#define SYSCALL_ENTRY(id,name,args) #name,
+#define SYSCALL_ENTRY(id,name,args) [id] = #name,
     ALL_SYSCALLS
 #undef SYSCALL_ENTRY
 };
@@ -757,9 +761,20 @@ void trace_syscall( UINT id, ULONG_PTR *args, ULONG len )
 {
     UINT idx = (id >> 12) & 3, num = id & 0xfff;
     const char **names = syscall_names[idx];
+    const char *name = NULL;
 
-    if (names && names[num])
-        TRACE_(syscall)( "\1SysCall  %s(", names[num] );
+    /* Table 0 is [id] = name and its size is max id + 1. A Windows id past
+     * that array must not be read. A hole inside it is NULL. */
+    if (idx == 0)
+    {
+        if (num < ARRAY_SIZE(ntsyscall_names))
+            name = ntsyscall_names[num];
+    }
+    else if (names)
+        name = names[num];
+
+    if (name)
+        TRACE_(syscall)( "\1SysCall  %s(", name );
     else
         TRACE_(syscall)( "\1SysCall  %04x(", id );
 
@@ -776,9 +791,18 @@ void trace_sysret( UINT id, ULONG_PTR retval )
 {
     UINT idx = (id >> 12) & 3, num = id & 0xfff;
     const char **names = syscall_names[idx];
+    const char *name = NULL;
+
+    if (idx == 0)
+    {
+        if (num < ARRAY_SIZE(ntsyscall_names))
+            name = ntsyscall_names[num];
+    }
+    else if (names)
+        name = names[num];
 
-    if (names && names[num])
-        TRACE_(syscall)( "\1SysRet   %s() retval=%08lx\n", names[num], retval );
+    if (name)
+        TRACE_(syscall)( "\1SysRet   %s() retval=%08lx\n", name, retval );
     else
         TRACE_(syscall)( "\1SysRet   %04x() retval=%08lx\n", id, retval );
 }
@@ -3066,8 +3090,8 @@ void ps5_extend_syscall_args( UINT mask, ULONG_PTR *args )
 
 #include "pw_wine_status.h"
 
-/* ntsyscall_names is the unix build's ALL_SYSCALLS list (the 32-bit numbers). Shared ntdll
- * services use the same number in the 64-bit list. A win32u id (table 1) has no length here. */
+/* ntsyscall_names is [id] = name. On this 64-bit build the id is the Windows 10
+ * build 19045 x64 number. A win32u id (table 1) has no name here. */
 static const char *ps5_syscall_name( unsigned int id )
 {
     unsigned int idx = (id >> 12) & 3;
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 441ca79..49e2acb 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -4140,6 +4140,8 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "jae " __ASM_LOCAL_LABEL("bad_syscall") "\n\t"
                    "movq (%rbx),%rcx\n\t"          /* table->ServiceTable */
                    "movq (%rcx,%rax,8),%r12\n\t"
+                   "testq %r12,%r12\n\t"           /* unimplemented id: the slot is NULL */
+                   "jz " __ASM_LOCAL_LABEL("bad_syscall") "\n\t"
                    "movq 24(%rbx),%rcx\n\t"        /* table->ArgumentTable */
                    "movzbl (%rcx,%rax),%ecx\n\t"
                    "subq $0x30,%rcx\n\t"
