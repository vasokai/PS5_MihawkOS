     if (ps5_mmu4k_signal( signal, siginfo, ucontext )) return;
     /* UMIP instructions are completed here. The log names any other SIGILL. */
     if (ps5_try_umip( ucontext, siginfo, signal )) return;
+    if (ps5_fastfail_int29( ucontext, signal )) return;
     if (ps5_emulate_windows_syscall( ucontext )) return;
 #endif
     rec.ExceptionAddress = (void *)RIP_sig(ucontext);
@@ -3984,6 +4175,7 @@
         leave_handler( ucontext );
         return;
     }
+    if (ps5_fastfail_int29( ucontext, signal )) return;
     if (ps5_emulate_windows_syscall( ucontext )) return;
 #endif
     if (handle_syscall_trap( ucontext, siginfo )) return;
@@ -4561,6 +4753,34 @@
     if (!status && old) *old = pw_native_actions[sig];
     return status;
 }
+
+/* 1253 returned from a Windows syscall number, so SIGSYS is not the path
+ * those numbers take. A number the kernel does reject lands here. A fault
+ * whose RIP is not an ntdll stub, or the byte after one, keeps SIG_DFL. */
+static void ps5_sigsys_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    ucontext_t *ucontext = init_handler( sigcontext );
+    BYTE prev[2];
+    ULONG_PTR rip;
+    struct sigaction dfl;
+
+    (void)siginfo;
+    if (ps5_emulate_windows_syscall( ucontext )) return;
+    rip = (ULONG_PTR)RIP_sig( ucontext );
+    if (rip >= 2 && ps5_read_bytes( (void *)(rip - 2), prev, sizeof(prev) ) &&
+        ((prev[0] == 0x0f && prev[1] == 0x05) || (prev[0] == 0xcd && prev[1] == 0x2e)))
+    {
+        RIP_sig( ucontext ) = rip - 2;
+        if (ps5_emulate_windows_syscall( ucontext )) return;
+        RIP_sig( ucontext ) = rip;
+    }
+    ps5_log_line( "wine-ps5: sigsys not-stub\n" );
+    memset( &dfl, 0, sizeof(dfl) );
+    dfl.sa_handler = SIG_DFL;
+    if (pw_raw_sigaction) pw_raw_sigaction( SIGSYS, &dfl, NULL );
+    else sigaction( SIGSYS, &dfl, NULL );
+    raise( signal );
+}
 #else
 # define pw_sigaction sigaction
 #endif
@@ -4666,9 +4886,14 @@
     sig_act.sa_sigaction = sigsys_handler;
     if (sigaction( SIGSYS, &sig_act, NULL ) == -1) goto error;
 #endif
+#ifdef __PROSPERO__
+    sig_act.sa_sigaction = ps5_sigsys_handler;
+    if (pw_sigaction( SIGSYS, &sig_act, NULL ) == -1) goto error;
+#endif
     install_bpf(&sig_act);
 #ifdef __PROSPERO__
     ps5_log_line( "wine-ps5: signal-init handlers=ready\n" );
+    ps5_enable_windows_thunks();
 #endif
     return;
 
