+
+/* Sibling <stem>_loader.dll, then a lowercase basename. From
+ * bizkut/ps5-forever-wine ee64b784 wine_ps5_title_game_image. Their
+ * game_launch hands the image to a separate title runtime and returns
+ * STATUS_CANCELLED. This process has no such callback: the existing
+ * helper spawn continues, and the line only records that the predicate
+ * matched. The leaf is the Windows basename, not a filesystem path. */
+static int ps5_loader_file_exists( const char *path )
+{
+    return path && !access( path, F_OK );
+}
+
+static void ps5_note_wow_loader( const UNICODE_STRING *image, const char *unix_name )
+{
+    char dos[1024], leaf[80], line[128];
+    const char *base, *p;
+    DWORD bytes = 0;
+
+    if (!image || !image->Buffer || !image->Length || !unix_name) return;
+    if (image->Length >= sizeof(dos)) return;
+    if (RtlUnicodeToUTF8N( dos, sizeof(dos) - 1, &bytes, image->Buffer, image->Length )) return;
+    if (bytes >= sizeof(dos)) return;
+    dos[bytes] = 0;
+    if (!pw_wow_game_image( dos, unix_name, ps5_loader_file_exists )) return;
+    base = dos;
+    for (p = dos; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    snprintf( leaf, sizeof(leaf), "%s", base );
+    snprintf( line, sizeof(line), "wine-ps5: wow-loader image=%s recognized=1\n", leaf );
+    wine_write_stderr( line, strlen( line ) );
+}
 #endif
 
