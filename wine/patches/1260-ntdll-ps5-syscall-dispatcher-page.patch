 extern void __wine_syscall_dispatcher_instrumentation(void);
 static void *instrumentation_callback;
 static pthread_mutex_t instrumentation_callback_mutex = PTHREAD_MUTEX_INITIALIZER;
+#ifdef __PROSPERO__
+/* bizkut/ps5-forever-wine ee64b784 maps this pointer on its own host page.
+ * The stock PE still names 0x7ffe1000 until the thunks are retargeted. */
+#define PS5_SYSCALL_DISPATCHER_PTR ((void *)0x7ffe4000)
+#define PS5_SYSCALL_DISPATCHER_PAGE 0x4000
+static int ps5_dispatcher_ready;
+#endif
 
 void set_process_instrumentation_callback( void *callback )
 {
     void *ptr = (char *)user_shared_data + page_size;
     sigset_t sigset;
-    void *old;
+    void *old, *entry;
 
     server_enter_uninterrupted_section( &instrumentation_callback_mutex, &sigset );
     old = InterlockedExchangePointer( &instrumentation_callback, callback );
-    if (!old && callback)      InterlockedExchangePointer( ptr, __wine_syscall_dispatcher_instrumentation );
-    else if (old && !callback) InterlockedExchangePointer( ptr, __wine_syscall_dispatcher );
+    if (!old && callback) entry = __wine_syscall_dispatcher_instrumentation;
+    else if (old && !callback) entry = __wine_syscall_dispatcher;
+    else entry = NULL;
+    if (entry)
+    {
+        InterlockedExchangePointer( ptr, entry );
+#ifdef __PROSPERO__
+        if (ps5_dispatcher_ready)
+            InterlockedExchangePointer( PS5_SYSCALL_DISPATCHER_PTR, entry );
+#endif
+    }
     server_leave_uninterrupted_section( &instrumentation_callback_mutex, &sigset );
 }
 
