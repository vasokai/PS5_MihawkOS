From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Subject: [PATCH] ntdll: PS5: leave the GE-Proton syscall thunk tail

Prospero still keeps SystemCall bit 0 set, so jne +3 does not execute
0f 05. After the handlers exist the tail stays the file's eb 01 and
call [0x7ffe1000], which is GE-Proton 11-7. Rewriting that tail to
cd 2e made WowClassic_loader's store at NtSetIoCompletion execute
pop rsp. int 2e is still emulated if a stub executes it. No console run.
---
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -2282,8 +2282,9 @@
     load_ntdll_functions( module );
 #if defined(__PROSPERO__) && defined(__x86_64__)
     /* Count the Win10 thunks and leave call [0x7ffe1000] in place.
-     * signal_init_process rewrites the tail to int 2e after the handlers
-     * exist. SystemCall stays 1: a Windows syscall number enters the kernel. */
+     * The tail stays the file's eb 01 and call [0x7ffe1000] after the
+     * handlers exist, which is GE-Proton 11-7's layout. SystemCall stays 1:
+     * a Windows syscall number enters the kernel. */
     ps5_arm_ntdll_syscalls( module );
 #endif
     if (is_arm64ec()) redirect_ntdll_functions( module );
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -3536,12 +3536,15 @@
  * call [0x7ffe1000]. That is the path process startup already ran, and it
  * is why 1255's early int 2e left Mihawk on a black screen.
  *
- * After the handlers are installed, the 0x20-byte thunk matches Win10 19045:
- * 4c 8b d1, mov eax, the shared-user test, 75 03, 0f 05, c3, cd 2e, c3,
- * and the 8-byte nop 0f 1f 84 00 00 00 00 00. jne +3 lands on int 2e.
- * The fault enters __wine_syscall_dispatcher at prolog_end. Nothing was
- * pushed. An rsp already inside the thread stack is left alone, and the
- * epilogue returns to the ret after int 2e.
+ * After the handlers are installed the tail stays those file bytes.
+ * GE-Proton 11-7's x64 thunk is 4c 8b d1, mov eax, the shared-user test,
+ * 75 03, 0f 05, c3, eb 01, c3, call [0x7ffe1000], c3. SystemCall bit 0
+ * is set, so jne +3 lands on eb 01 and the call, not on 0f 05.
+ * WowClassic_loader hot-patches that layout. Rewriting eb 01 and the call
+ * into cd 2e and an 8-byte nop is the byte change the Classic Era run
+ * then overwrote: the first 11 bytes became 5c 24 30 ba 00 04 00 00 48 89 d9,
+ * pop rsp ran, and #GP fired at the leftover displacement. int 2e is still
+ * emulated if a stub executes it. The call path is what the guest runs.
  *
  * Every thread resumes its own int 2e. A process-wide depth counter turned
  * the loser's #GP into an access violation at the cd 2e (1257: NtReleaseMutant
@@ -3971,8 +3974,8 @@
 }
 
 /* Leave the thunks on call [0x7ffe1000]. The line is written before the scan
- * so a fault in the walk is still named. path=call is this process until
- * ps5_enable_windows_thunks runs, which is after the signal handlers. */
+ * so a fault in the walk is still named. path=call stays after the handlers:
+ * the file tail is not rewritten. */
 void ps5_arm_ntdll_syscalls( void *module )
 {
     unsigned int syscall_sites = 0, int2e_sites = 0, systemcall;
@@ -4009,11 +4012,11 @@
     ps5_log_line( line );
 }
 
-/* Win10 19045's x64 thunk is 0x20 bytes. The file has eb 01 and
- * call [0x7ffe1000] where Windows has cd 2e and an 8-byte nop. Rewrite
- * that tail only. 0f 05 stays, and SystemCall stays 1, so jne +3 executes
- * int 2e instead of entering the Prospero kernel. */
-static void ps5_enable_windows_thunks(void)
+/* GE-Proton 11-7's x64 thunk tail, from the shared-user test through the
+ * call [0x7ffe1000] ret. wine is that tail. win10 is the same test with
+ * cd 2e and an 8-byte nop in place of eb 01 and the call. This counts
+ * them and does not store. SystemCall stays 1, so jne +3 takes eb 01. */
+static void ps5_keep_stock_thunks(void)
 {
     static const BYTE wine_tail[24] = {
         0xf6, 0x04, 0x25, 0x08, 0x03, 0xfe, 0x7f, 0x01,
@@ -4025,14 +4028,10 @@
         0x75, 0x03, 0x0f, 0x05, 0xc3, 0xcd, 0x2e, 0xc3,
         0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00
     };
-    static const BYTE repl[11] = {
-        0xcd, 0x2e, 0xc3, 0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00
-    };
     IMAGE_DOS_HEADER *dos = ps5_ntdll_module;
     IMAGE_NT_HEADERS *nt;
     IMAGE_SECTION_HEADER *sec;
-    unsigned int i, armed = 0, already = 0, failed = 0;
-    unsigned int eax, ebx, ecx, edx, systemcall, n;
+    unsigned int i, wine = 0, win10 = 0, systemcall, n;
     ULONG_PTR sample = 0;
     BYTE shown[32];
     char hex[72], line[400];
@@ -4050,22 +4049,15 @@
             {
                 BYTE *start;
                 SIZE_T size, off;
-                void *addr;
-                ULONG old = 0;
-                int opened = 0;
 
                 if (!(sec[i].Characteristics & IMAGE_SCN_MEM_EXECUTE)) continue;
                 size = sec[i].Misc.VirtualSize;
                 if (size < 24) continue;
                 start = (BYTE *)dos + sec[i].VirtualAddress;
-                addr = start;
-                if (!NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size,
-                                             PAGE_EXECUTE_READWRITE, &old ))
-                    opened = 1;
-                for (off = 0; off + 24 <= sec[i].Misc.VirtualSize; )
+                for (off = 0; off + 24 <= size; )
                 {
                     BYTE buf[4096];
-                    SIZE_T chunk = sec[i].Misc.VirtualSize - off;
+                    SIZE_T chunk = size - off;
                     SIZE_T got, j;
 
                     if (chunk > sizeof(buf)) chunk = sizeof(buf);
@@ -4073,46 +4065,25 @@
                     if (got < 24) break;
                     for (j = 0; j + 24 <= got; j++)
                     {
-                        if (!memcmp( buf + j, win_tail, sizeof(win_tail) ))
+                        if (!memcmp( buf + j, wine_tail, sizeof(wine_tail) ))
                         {
                             if (!sample) sample = (ULONG_PTR)(start + off + j) - 8;
-                            already++;
+                            wine++;
                             j += 23;
                             continue;
                         }
-                        if (memcmp( buf + j, wine_tail, sizeof(wine_tail) )) continue;
-                        if (!opened ||
-                            virtual_uninterrupted_write_memory( start + off + j + 13, repl, sizeof(repl) ))
-                            failed++;
-                        else
+                        if (!memcmp( buf + j, win_tail, sizeof(win_tail) ))
                         {
                             if (!sample) sample = (ULONG_PTR)(start + off + j) - 8;
-                            armed++;
+                            win10++;
+                            j += 23;
                         }
-                        j += 23;
                     }
                     off += got - 23;
                 }
-                if (opened)
-                {
-                    ULONG dummy;
-
-                    addr = start;
-                    size = sec[i].Misc.VirtualSize;
-                    NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, old, &dummy );
-                }
             }
         }
     }
-    if (armed)
-    {
-        /* x86 NtFlushInstructionCache is a no-op. cpuid serializes, so the
-         * new bytes are what the next guest thunk fetches. */
-        NtFlushInstructionCache( NtCurrentProcess(), ps5_ntdll_module, 0 );
-        __asm__ volatile( "cpuid"
-                          : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx)
-                          : "a"(0) : "memory" );
-    }
     if (sample && ps5_read_bytes( (void *)sample, shown, sizeof(shown) ))
     {
         for (n = 0; n < sizeof(shown); n++)
@@ -4121,9 +4092,9 @@
     }
     systemcall = ps5_keep_system_call();
     snprintf( line, sizeof(line),
-              "wine-ps5: syscall-int2e ntdll armed=%u already=%u failed=%u systemcall=%#x "
-              "path=int2e trap=cd2e reason=syscall-collides sample=%s\n",
-              armed, already, failed, systemcall, sample_text );
+              "wine-ps5: syscall-thunk ntdll wine=%u win10=%u systemcall=%#x "
+              "path=call tail=eb01+call sample=%s\n",
+              wine, win10, systemcall, sample_text );
     ps5_log_line( line );
 }
 #endif
@@ -4984,7 +4955,7 @@
     install_bpf(&sig_act);
 #ifdef __PROSPERO__
     ps5_log_line( "wine-ps5: signal-init handlers=ready\n" );
-    ps5_enable_windows_thunks();
+    ps5_keep_stock_thunks();
 #endif
     return;
 
