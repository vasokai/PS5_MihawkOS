From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Subject: [PATCH] ntdll: PS5: resume every thread's int 2e

1257 turned a second thread's int 2e into an access violation. The
emulator's depth counter was process-wide, so the loser of that race
was delivered as a #GP at cd 2e. The depth is now per thread, and the
opcode is read without the virtual-memory lock. NtContinue stays on
the Win10 bytes. No console run.
---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -670,6 +670,7 @@
     DWORD                 wow_alias;     /* 0348 the 32-bit TEB: 0 not placed yet, 1 at the FS base's low half, 2 switched */
     DWORD                 ps5_callback_depth; /* 034c KeUserModeCallback nesting; the PE handler reads this offset */
     DWORD                 ps5_callback_id;    /* 0350 the id argument, valid while depth is non-zero */
+    DWORD                 ps5_syscall_emu;    /* 0354 this thread's int 2e emulation depth */
     void                 *ps5_callback_stack; /* 0358 callback_stack_layout of the active call */
 #endif
 };
@@ -685,6 +686,7 @@
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, wow_alias ) == 0x348 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, ps5_callback_depth ) == 0x34c );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, ps5_callback_id ) == 0x350 );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, ps5_syscall_emu ) == 0x354 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, ps5_callback_stack ) == 0x358 );
 /* ps5_module_of reads these fields by offset. The PE handler uses the struct. */
 C_ASSERT( offsetof( LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks ) == 0x10 );
@@ -2108,17 +2110,29 @@
     }
 }
 
-/* 32 bytes at pc-0x14, the NtSetIoCompletion stub when the fault is the ret at
- * +0x14. exec is the mapping the CPU fetches. rw is an alias window that already
- * maps that host page's direct memory; JIT and file pages have none, and this
- * does not create one. systemcall is the byte the stub tests at 0x7ffe0308. */
+/* 32 bytes at the stub. int 2e is at +0x15 and syscall at +0x12; the ret the
+ * 1254 fault stopped on is at +0x14. exec is the mapping the CPU fetches.
+ * rw is an alias window that already maps that host page's direct memory;
+ * JIT and file pages have none, and this does not create one. systemcall is
+ * the byte the stub tests at 0x7ffe0308. */
 static void ps5_log_stub_bytes( ULONG_PTR pc )
 {
     char exec[80], rw[80], line[320];
-    ULONG_PTR stub = pc >= 0x14 ? pc - 0x14 : pc;
-    uintptr_t host = (uintptr_t)stub & ~(uintptr_t)(PW_WINE_ALIAS_HOST_PAGE - 1);
-    uintptr_t alias = host ? pw_wine_alias_find( host ) : 0;
-    unsigned int systemcall = user_shared_data ? user_shared_data->SystemCall : 0xffffffff;
+    BYTE op[2];
+    ULONG_PTR back = 0x14;
+    ULONG_PTR stub;
+    uintptr_t host, alias;
+    unsigned int systemcall;
+
+    if (ps5_read_bytes( (void *)pc, op, sizeof(op) ))
+    {
+        if (op[0] == 0xcd && op[1] == 0x2e) back = 0x15;
+        else if (op[0] == 0x0f && op[1] == 0x05) back = 0x12;
+    }
+    stub = pc >= back ? pc - back : pc;
+    host = (uintptr_t)stub & ~(uintptr_t)(PW_WINE_ALIAS_HOST_PAGE - 1);
+    alias = host ? pw_wine_alias_find( host ) : 0;
+    systemcall = user_shared_data ? user_shared_data->SystemCall : 0xffffffff;
 
     ps5_format_bytes( exec, sizeof(exec), (void *)stub, 32 );
     if (alias)
@@ -2876,6 +2890,10 @@
 #endif
 }
 
+#ifdef __PROSPERO__
+static BOOL ps5_emulate_windows_syscall( ucontext_t *ctx );
+#endif
+
 /***********************************************************************
  *           handle_interrupt
  *
@@ -2895,6 +2913,14 @@
         rec->ExceptionInformation[0] = context->Rcx;
         NtRaiseException( rec, context, FALSE );
         return TRUE;
+#ifdef __PROSPERO__
+    case 0x2e:
+        /* Win10's taken path. segv_handler tries first. This is the same
+         * resume for a #GP whose vector is 0x2e. A miss stays an access
+         * violation, and syscall-emu skip names why. */
+        if (ps5_emulate_windows_syscall( sigcontext )) return TRUE;
+        return FALSE;
+#endif
     case 0x2c:
         rec->ExceptionCode = STATUS_ASSERTION_FAILURE;
         break;
@@ -3517,11 +3543,18 @@
  * pushed. An rsp already inside the thread stack is left alone, and the
  * epilogue returns to the ret after int 2e.
  *
+ * Every thread resumes its own int 2e. A process-wide depth counter turned
+ * the loser's #GP into an access violation at the cd 2e (1257: NtReleaseMutant
+ * 0x20 at ntdll+0x56a55, NtFsControlFile 0x39 at +0x56d75, NtContinue 0x43
+ * at +0x56eb5). The depth is per thread. The opcode is read from the page
+ * the CPU fetched, without virtual_mutex.
+ *
  * The call-path repair stays for a thunk that still has call [0x7ffe1000]
  * and a smashed rsp. int 0x29 is __fastfail even when the trap is not
  * reported as an IDT error: STATUS_STACK_BUFFER_OVERRUN, code in RCX. */
 
 static void *ps5_ntdll_module;
+static ULONG_PTR ps5_ntdll_base, ps5_ntdll_end;
 
 /* SizeOfImage is 80 bytes into the NT headers (signature, file header, then
  * OptionalHeader64 up to that field). A bad header falls through to the name. */
@@ -3531,6 +3564,8 @@
     DWORD size = 0;
     char where[80];
 
+    if (ps5_ntdll_end && pc >= ps5_ntdll_base && pc < ps5_ntdll_end)
+        return 1;
     if (ps5_ntdll_module &&
         ps5_read_bytes( ps5_ntdll_module, &dos, sizeof(dos) ) &&
         dos.e_magic == IMAGE_DOS_SIGNATURE &&
@@ -3619,61 +3654,105 @@
     return first;
 }
 
+/* The CPU fetched these bytes. Reading them through virtual_mutex stalls
+ * every other thread's int 2e behind whoever holds that lock. */
+static int ps5_read_fetched( const void *addr, void *buf, SIZE_T size )
+{
+    volatile const BYTE *src = addr;
+    BYTE *dst = buf;
+    SIZE_T i;
+
+    if (!addr || !buf || !size || size > 16) return 0;
+    for (i = 0; i < size; i++) dst[i] = src[i];
+    return 1;
+}
+
+static void ps5_syscall_skip( BYTE op0, BYTE op1, ULONG_PTR rip, ULONG_PTR rsp,
+                               unsigned int id, unsigned int cs, const char *why )
+{
+    static int lines;
+    char line[240];
+
+    if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) >= 16) return;
+    snprintf( line, sizeof(line),
+              "wine-ps5: syscall-emu skip op=%02x%02x rip=%p rsp=%p id=%#x cs=%#x why=%s\n",
+              op0, op1, (void *)rip, (void *)rsp, id, cs, why );
+    ps5_log_line( line );
+}
+
 /* TRUE when the signal frame now resumes at prolog_end. int 2e is at +0x15
  * and syscall is at +0x12. RIP is the faulting instruction: the kernel has
  * not advanced it. prolog_end subtracts 0xb, so frame->rip is landing+0xb
  * and the epilogue returns to the stub's ret. RSP is not popped. A stack
  * range that is not set yet is left as the CPU delivered it. An rsp outside
- * a stack that is set is the pop rsp case; the qword is still in the stack. */
+ * a stack that is set is the pop rsp case; the qword is still in the stack.
+ * The depth counter is this thread's. Another thread's int 2e still resumes.
+ * NtContinue, NtCallbackReturn and NtRaiseException use this same frame:
+ * that is the frame the call path would have overwritten. */
 static BOOL ps5_emulate_windows_syscall( ucontext_t *ctx )
 {
     extern const void *__wine_syscall_dispatcher_prolog_end_ptr;
     struct syscall_frame *frame;
+    struct amd64_thread_data *cpu;
+    TEB *teb;
     BYTE op[2], prefix[3];
-    ULONG_PTR rip, rsp, limit = 0, base = 0, slot, landing, stub_off;
-    unsigned int slots = 0;
-    int restored = 0, stack_set, depth;
-    static int lines, skips, emu_depth;
-    char line[360];
+    ULONG_PTR rip, rsp, limit, base, slot, landing, stub_off;
+    unsigned int slots, id, cs;
+    int restored, depth, in64, stack_set;
+    static int lines;
+    char line[400];
 
+    limit = 0;
+    base = 0;
+    slots = 0;
+    restored = 0;
+    depth = 0;
+    cpu = NULL;
     rip = (ULONG_PTR)RIP_sig(ctx);
-    if (!ps5_read_bytes( (void *)rip, op, sizeof(op) )) return FALSE;
+    if (!ps5_read_fetched( (void *)rip, op, sizeof(op) )) return FALSE;
     if (!((op[0] == 0x0f && op[1] == 0x05) || (op[0] == 0xcd && op[1] == 0x2e))) return FALSE;
-    if (cs32_sel && CS_sig(ctx) == cs32_sel) return FALSE;
-    depth = __atomic_fetch_add( &emu_depth, 1, __ATOMIC_RELAXED );
-    if (depth)
+    rsp = (ULONG_PTR)RSP_sig(ctx);
+    id = (unsigned int)RAX_sig(ctx);
+    cs = (unsigned int)CS_sig(ctx);
+    in64 = ps5_ntdll_end && rip >= ps5_ntdll_base && rip < ps5_ntdll_end;
+    /* A 32-bit code segment's int 2e stays with signal_i386.c. A stub inside
+     * the 64-bit image is resumed even when the saved CS equals that selector. */
+    if (!in64 && cs32_sel && cs == cs32_sel) return FALSE;
+    if (!in64 && !ps5_pc_in_ntdll( rip ))
     {
-        __atomic_fetch_sub( &emu_depth, 1, __ATOMIC_RELAXED );
+        ps5_syscall_skip( op[0], op[1], rip, rsp, id, cs, "range" );
         return FALSE;
     }
-    if (!ps5_pc_in_ntdll( rip ))
+
+    teb = NtCurrentTeb();
+    if (teb) cpu = amd64_thread_data();
+    if (cpu)
     {
-        __atomic_fetch_sub( &emu_depth, 1, __ATOMIC_RELAXED );
-        return FALSE;
+        depth = ++cpu->ps5_syscall_emu;
+        if (depth > 4)
+        {
+            cpu->ps5_syscall_emu--;
+            ps5_syscall_skip( op[0], op[1], rip, rsp, id, cs, "reenter" );
+            return FALSE;
+        }
     }
 
     frame = get_syscall_frame();
-    rsp = (ULONG_PTR)RSP_sig(ctx);
-    if (NtCurrentTeb())
+    if (teb)
     {
-        limit = (ULONG_PTR)NtCurrentTeb()->Tib.StackLimit;
-        base = (ULONG_PTR)NtCurrentTeb()->Tib.StackBase;
+        limit = (ULONG_PTR)teb->Tib.StackLimit;
+        base = (ULONG_PTR)teb->Tib.StackBase;
     }
     stack_set = base > limit && base - limit <= (8ull << 20);
-    if (stack_set && (rsp < limit || rsp >= base))
+    /* The stack walk takes virtual_mutex. Skip it on a nested entry so the
+     * walk cannot re-enter this function while the counter is held. */
+    if (depth <= 1 && stack_set && (rsp < limit || rsp >= base))
     {
         slot = ps5_find_stack_slot( limit, base, rsp, &slots );
         if (!slot)
         {
-            if (__atomic_fetch_add( &skips, 1, __ATOMIC_RELAXED ) < 8)
-            {
-                snprintf( line, sizeof(line),
-                          "wine-ps5: syscall-emu skip op=%02x%02x rip=%p rsp=%p rcx=%#llx why=stack\n",
-                          op[0], op[1], (void *)rip, (void *)rsp,
-                          (unsigned long long)RCX_sig(ctx) );
-                ps5_log_line( line );
-            }
-            __atomic_fetch_sub( &emu_depth, 1, __ATOMIC_RELAXED );
+            ps5_syscall_skip( op[0], op[1], rip, rsp, id, cs, "stack" );
+            if (cpu) cpu->ps5_syscall_emu--;
             return FALSE;
         }
         rsp = slot;
@@ -3681,29 +3760,28 @@
     }
     if (!frame)
     {
-        if (__atomic_fetch_add( &skips, 1, __ATOMIC_RELAXED ) < 8)
-            ps5_log_line( "wine-ps5: syscall-emu skip why=frame\n" );
-        __atomic_fetch_sub( &emu_depth, 1, __ATOMIC_RELAXED );
+        ps5_syscall_skip( op[0], op[1], rip, rsp, id, cs, "frame" );
+        if (cpu) cpu->ps5_syscall_emu--;
         return FALSE;
     }
 
     prefix[0] = prefix[1] = prefix[2] = 0;
     /* cd 2e is the Windows instruction at +0x15. 0f 05 is at +0x12. */
     stub_off = (op[0] == 0xcd) ? 0x15 : 0x12;
-    if (rip >= stub_off) ps5_read_bytes( (void *)(rip - stub_off), prefix, sizeof(prefix) );
+    if (rip >= stub_off) ps5_read_fetched( (void *)(rip - stub_off), prefix, sizeof(prefix) );
     /* 5c 8b d1 is pop rsp; mov edx, ecx. mov r10, rcx did not run. rcx is
      * still the first argument. Apply it only once the resume is decided. */
     if (prefix[0] == 0x5c && prefix[1] == 0x8b && prefix[2] == 0xd1)
         R10_sig(ctx) = RCX_sig(ctx);
-    if (__atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) < 32)
+    if (depth <= 1 && __atomic_fetch_add( &lines, 1, __ATOMIC_RELAXED ) < 32)
     {
         snprintf( line, sizeof(line),
                   "wine-ps5: syscall-emu id=%#x op=%02x%02x rip=%p rsp=%p r10=%#llx rcx=%#llx rdx=%#llx "
-                  "prefix=%02x%02x%02x restored=%d slots=%u\n",
-                  (unsigned int)RAX_sig(ctx), op[0], op[1], (void *)rip, (void *)rsp,
+                  "prefix=%02x%02x%02x restored=%d slots=%u cs=%#x\n",
+                  id, op[0], op[1], (void *)rip, (void *)rsp,
                   (unsigned long long)R10_sig(ctx), (unsigned long long)RCX_sig(ctx),
                   (unsigned long long)RDX_sig(ctx), prefix[0], prefix[1], prefix[2],
-                  restored, slots );
+                  restored, slots, cs );
         ps5_log_line( line );
     }
 
@@ -3722,7 +3800,7 @@
     }
     RSP_sig(ctx) = rsp;
     RIP_sig(ctx) = (ULONG64)__wine_syscall_dispatcher_prolog_end_ptr;
-    __atomic_fetch_sub( &emu_depth, 1, __ATOMIC_RELAXED );
+    if (cpu) cpu->ps5_syscall_emu--;
     return TRUE;
 }
 
@@ -3898,9 +3976,22 @@
 void ps5_arm_ntdll_syscalls( void *module )
 {
     unsigned int syscall_sites = 0, int2e_sites = 0, systemcall;
+    IMAGE_DOS_HEADER dos;
+    DWORD image = 0;
     char line[160];
 
     ps5_ntdll_module = module;
+    ps5_ntdll_base = 0;
+    ps5_ntdll_end = 0;
+    if (module && ps5_read_bytes( module, &dos, sizeof(dos) ) &&
+        dos.e_magic == IMAGE_DOS_SIGNATURE &&
+        dos.e_lfanew >= 0x40 && dos.e_lfanew < 0x1000 &&
+        ps5_read_bytes( (char *)module + dos.e_lfanew + 80, &image, sizeof(image) ) &&
+        image > 0x1000 && image < 0x10000000)
+    {
+        ps5_ntdll_base = (ULONG_PTR)module;
+        ps5_ntdll_end = ps5_ntdll_base + image;
+    }
     systemcall = user_shared_data ? user_shared_data->SystemCall : 0xffffffff;
     snprintf( line, sizeof(line), "wine-ps5: syscall-boot systemcall=%#x\n", systemcall );
     ps5_log_line( line );
